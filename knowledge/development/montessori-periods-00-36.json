{
  "metadata": {
    "id": "montessori-periods-00-36",
    "name": "0-36个月蒙氏敏感期与家庭观察索引",
    "version": "2026.08.02-preview",
    "scope": "用于 Baby Growth OS 月龄推送、家长问答、照片/事件知识映射",
    "important_note": "敏感期是观察线索，不是诊断标签。孩子发展存在个体差异，不应制造焦虑。"
  },
  "periods": [
    {
      "age_range_months": [0, 3],
      "focus": ["视觉", "听觉", "触觉", "安全依恋", "俯趴准备"],
      "signals": ["喜欢看黑白高对比图案", "会寻找熟悉声音", "被轻柔触碰安抚", "短时间俯趴抬头尝试"],
      "family_environment": ["光线柔和", "减少过度刺激", "准备黑白卡或简单移动物", "给安全俯趴空间"],
      "activities": ["黑白卡慢速追视", "摇铃定位", "婴儿抚触", "清醒时短时间俯趴"],
      "record_prompts": ["今天宝宝能追视多远？", "哪个声音最能安抚？", "俯趴能坚持多久？"],
      "avoid": ["长时间强刺激", "把抬头时间和同龄孩子硬比较"]
    },
    {
      "age_range_months": [3, 6],
      "focus": ["抓握", "口腔探索", "翻身", "镜像认知", "秩序萌芽"],
      "signals": ["主动伸手抓物", "喜欢把安全物品放入口中探索", "尝试翻身", "对镜子中的脸感兴趣"],
      "family_environment": ["提供安全牙胶和不同触感物", "地面活动空间", "镜子固定安全", "玩具少量轮换"],
      "activities": ["抓握布巾或软环", "安全牙胶探索", "翻身辅助游戏", "镜子互动"],
      "record_prompts": ["今天主动抓住了什么？", "是否开始从仰卧转侧身？", "最喜欢哪类触感？"],
      "avoid": ["入口物不安全", "过度使用限制运动的设备"]
    },
    {
      "age_range_months": [6, 9],
      "focus": ["爬行准备", "物体恒存", "手眼协调", "语言声音", "秩序感"],
      "signals": ["寻找被遮住的物品", "用手拍打/转移物品", "发出重复音节", "尝试匍匐或爬行"],
      "family_environment": ["安全地垫", "可滚动玩具", "简单藏找游戏", "固定喂养和睡前流程"],
      "activities": ["滚球追爬", "布下找物", "双手传递玩具", "回应式咿呀对话"],
      "record_prompts": ["今天是否追着物品移动？", "出现了哪些重复音节？", "对固定流程有什么反应？"],
      "avoid": ["把不会爬直接等同于落后", "环境杂乱导致孩子难以移动"]
    },
    {
      "age_range_months": [9, 12],
      "focus": ["扶站与行走准备", "精细动作", "因果探索", "模仿", "简单规则"],
      "signals": ["扶物站立", "用手指捏小物", "反复开合/敲打", "模仿拍手或挥手"],
      "family_environment": ["稳定扶站物", "安全开合盒", "大颗粒投放玩具", "可重复的告别/欢迎动作"],
      "activities": ["投放游戏", "开合盒", "扶站取物", "拍手挥手模仿"],
      "record_prompts": ["今天最爱重复哪个动作？", "能否用拇指和食指捏取？", "是否开始理解简单边界？"],
      "avoid": ["为了训练行走强拉手", "提供容易吞咽的小物"]
    },
    {
      "age_range_months": [12, 18],
      "focus": ["行走", "独立性", "真实生活动作", "语言理解", "秩序感"],
      "signals": ["想自己走和搬东西", "模仿擦桌子/拿勺", "听懂简单指令", "对物品位置变化敏感"],
      "family_environment": ["低矮挂钩", "孩子可用的小杯勺", "固定收纳位置", "安全可搬运物品"],
      "activities": ["递衣服", "擦桌子", "小杯喝水", "把物品放回固定位置"],
      "record_prompts": ["今天孩子主动想自己做什么？", "哪个环境位置最能帮助他完成？", "是否因流程变化哭闹？"],
      "avoid": ["因怕慢而全部代劳", "对秩序敏感只解释为任性"]
    },
    {
      "age_range_months": [18, 24],
      "focus": ["秩序感高峰", "自我意识", "生活自理", "语言爆发", "有限选择"],
      "signals": ["坚持固定路线或步骤", "频繁说不要/自己来", "想参与穿脱、洗手、刷牙", "词汇快速增加"],
      "family_environment": ["稳定作息流程图", "两选一选择", "儿童尺寸工具", "明确且短的边界句"],
      "activities": ["鞋子归位", "洗手流程", "倒水擦水", "给玩偶穿衣"],
      "record_prompts": ["今天最坚持哪个顺序？", "给选择后是否更愿意配合？", "新说了哪些词？"],
      "avoid": ["把说“不”当成故意对抗", "在赶时间时临时引入复杂训练"]
    },
    {
      "age_range_months": [24, 36],
      "focus": ["语言表达", "社交边界", "如厕准备", "角色游戏", "动作精细化", "规则理解"],
      "signals": ["用短句表达需求", "喜欢角色扮演", "开始理解轮流", "对马桶/内裤/身体信号感兴趣", "喜欢剪、倒、夹、穿等精细动作"],
      "family_environment": ["清楚的生活流程", "低风险真实工具", "轮流游戏材料", "可独立取放的绘本和活动托盘"],
      "activities": ["夹夹子", "倒豆子或倒水", "角色扮演照顾娃娃", "轮流滚球", "如厕信号观察"],
      "record_prompts": ["孩子今天主动表达了什么？", "能等待几轮？", "对如厕出现了哪些准备信号？"],
      "avoid": ["强迫分享", "把如厕训练变成奖惩压力", "忽视孩子的工作重复需求"]
    }
  ],
  "usage_rules": [
    "推送时优先结合孩子真实记录，不要只按月龄机械推。",
    "如果家长上传照片，先识别行为事实，再关联到一个可能的敏感期。",
    "每次只给一个家庭动作和一个记录任务。",
    "当孩子行为涉及安全风险，边界优先于活动自由。"
  ]
}
